# Auth0 Configuration — Regular Web Application (confidential client), not the
# old SPA registration: this app exchanges the authorization code server-side.
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
BASE_URL=http://localhost:5200
# Optional: Only needed if you're calling an API
# AUTH0_AUDIENCE=your-api-identifier
# Optional: comma-separated scopes. offline_access is always added even if
# omitted (needed for refresh tokens).
# AUTH0_SCOPES=openid,profile,email

# Signs the httpOnly session cookie
USER_SESSION_SECRET=your-secure-session-secret

# Backend API (read server-side; no longer exposed to the browser)
API_URL=http://localhost:5000
# ALLOW_INSECURE_API=true

# Optional: real Redis connection string. Absent → in-memory mock (fine for local dev).
# REDIS_URL=redis://localhost:6379

# Currency Configuration
# Override the default currency IDs if needed
# These should match the GUIDs from your backend database

# US Dollar currency ID
VITE_USD_CURRENCY_ID=efbf50bc-34d4-43e9-96f9-9f6213ea11b5

# Argentine Peso currency ID  
VITE_ARS_CURRENCY_ID=6d189135-7040-45a1-b713-b1aa6cad1720
